# AION — Provider API Keys
# Copy this file to .env and fill in the keys for providers you use.
#
#   cp .env.example .env
#
# Only uncomment providers you have configured in configs/aion.yaml.

# --- Cloud providers (uncomment the ones you use) ---
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...
# GEMINI_API_KEY=...
# XAI_API_KEY=...

# AWS Bedrock (bearer token or use IAM roles in production)
# AWS_BEARER_TOKEN_BEDROCK=...

# Google Vertex AI
# VERTEX_BEARER_TOKEN=...

# --- Local model (optional, defaults shown) ---
# Override to use a different HuggingFace GGUF model:
# LLAMA_MODEL_REPO=Qwen/Qwen2.5-1.5B-Instruct-GGUF
# LLAMA_MODEL_FILE=qwen2.5-1.5b-instruct-q4_k_m.gguf
